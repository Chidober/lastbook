# Prefer: bash docker/deploy.sh
# Mount the parent folder (relative to docker/). It will hold LastbookData,
# LastbookData.setup (the download) and config. Do not mount LastbookData itself.

LASTBOOK_HOST_ROOT=../data

LMSTUDIO_URL=http://192.168.1.11:1234
LMSTUDIO_TOKEN=replace-with-your-lmstudio-api-token
SURVIVAL_MODEL=replace-with-model-id

SURVIVAL_REASONING_EFFORT=none
LASTBOOK_PORT=8890
LASTBOOK_LAN=0

# Used by deploy.sh only: small | medium | all | none
LASTBOOK_PACK=small
