# Prefer: bash docker/deploy.sh  (writes absolute paths under <repo>/data/)
# Manual compose: paths are relative to this docker/ folder, so use ../data/...

LASTBOOK_DATA_HOST=../data/LastbookData
LASTBOOK_CONFIG_HOST=../data/config

LMSTUDIO_URL=http://192.168.1.11:1234
LMSTUDIO_TOKEN=replace-with-your-lmstudio-api-token
SURVIVAL_MODEL=replace-with-model-id

SURVIVAL_REASONING_EFFORT=none
LASTBOOK_PORT=8890
LASTBOOK_LAN=0

# Used by deploy.sh only: small | medium | all | none
LASTBOOK_PACK=small
